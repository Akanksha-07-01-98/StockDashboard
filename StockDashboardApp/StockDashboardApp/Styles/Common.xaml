<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="lightGreen">#799540</Color>
    <Color x:Key="darkGreen">#50632b</Color>
    <SolidColorBrush x:Key="PrimaryColor1" Color="{StaticResource lightGreen}"/>
    <SolidColorBrush x:Key="PrimaryColor2" Color="{StaticResource darkGreen}"/>
</ResourceDictionary>
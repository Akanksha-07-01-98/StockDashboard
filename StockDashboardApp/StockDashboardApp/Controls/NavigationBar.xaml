<UserControl x:Class="StockDashboardApp.Controls.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StockDashboardApp.Controls"
             xmlns:nav="clr-namespace:StockDashboardApp.Enums"
             xmlns:vm="clr-namespace:StockDashboardApp.ViewModel"
             xmlns:converter="clr-namespace:StockDashboardApp.Converter"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converter:ViewTypeToBooleanConverter x:Key="ViewModelConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Simple Trader" Grid.Row="0" Padding="10"
                   FontSize="28"
                   Foreground="White"
                   Background="{StaticResource PrimaryColor1}"/>
        <Grid  Grid.Row="1" Background="{StaticResource PrimaryColor2}">
            <Grid.Resources>
                <Style TargetType="RadioButton" BasedOn="{StaticResource navButton}">
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition  Width="Auto"/>
                <ColumnDefinition  Width="Auto"/>
                <ColumnDefinition  Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RadioButton Content="Home" Grid.Column="0"
                         IsChecked="{Binding CurrentViewModel,Mode=OneWay,Converter={StaticResource ViewModelConverter},
                ConverterParameter={x:Type vm:HomeViewModel}}"
                         Command="{Binding UpdateCurrentViewModelCommand}"
                         CommandParameter="{x:Static nav:ViewType.Home}"></RadioButton>
            <RadioButton Content="Portfolio" Grid.Column="1"
                                  IsChecked="{Binding CurrentViewModel,Mode=OneWay,Converter={StaticResource ViewModelConverter},
                                   ConverterParameter={x:Type vm:PortfolioViewModel}}"
                          Command="{Binding UpdateCurrentViewModelCommand}"
                         CommandParameter="{x:Static nav:ViewType.Portfolio}"></RadioButton>
            <RadioButton Content="Buy" Grid.Column="2"
                          Command="{Binding UpdateCurrentViewModelCommand}"
                         CommandParameter="{x:Static nav:ViewType.Buy}"></RadioButton>
            <RadioButton Content="Sell" Grid.Column="3"
                          Command="{Binding UpdateCurrentViewModelCommand}"
                         CommandParameter="{x:Static nav:ViewType.Sell}"></RadioButton>
        </Grid>
    </Grid>
</UserControl>
